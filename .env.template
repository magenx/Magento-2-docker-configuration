IMGPROXY_DOWNLOAD_TIMEOUT=5
IMGPROXY_ENABLE_DEBUG_HEADERS=true

## Private admin access (README): cloudflared starts with the stack and needs TUNNEL_TOKEN in .env.secrets.
## The admin stays on DOMAIN behind nginx ipset/allow.conf until the Magento admin URL points at the private hostname.
## Add "adminer" for the MariaDB web UI at /mariadb/ of the private admin hostname, see README.
COMPOSE_PROFILES=""

## Cloudflare Tunnel: admin access through Cloudflare Zero Trust, starts with the stack, see README
## Hostnames and Access policies are set in the Cloudflare Zero Trust dashboard (dashboard-managed tunnel).
## base of cloudflared/Dockerfile, cloudflared:2026.11.0-debian13
CLOUDFLARED_IMAGE="dhi.io/cloudflared:2026.11.0-debian13@sha256:a12a1d726c91ededb4f182fd8a6385974ab5eb8e16c055242f857403b2451a7b"
## Container settings, passed to the cloudflared container as they are (cloudflared tunnel run --help)
## TUNNEL_TOKEN is in .env.secrets
## metrics and /ready for the healthcheck, inside the container only
TUNNEL_METRICS="127.0.0.1:20241"
## debug, info, warn, error, fatal
TUNNEL_LOGLEVEL="info"

## Adminer (profile "adminer"): MySQL-only single-file release served by the adminer container at /mariadb/
## of the private admin hostname, see README.
## github.com/vrana/adminer; the build checks the file against ADMINER_SHA256 (sha256sum of the release asset)
ADMINER_VERSION="6.3.0"
ADMINER_SHA256="8bc0c48b26d0fbbe2698a1766c7afc65a4681c8efbb2f18e2dc57a9530367bbd"

## passwords, magento keys and the random admin path are in .env.secrets
