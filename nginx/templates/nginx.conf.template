user  nginx;
worker_processes  auto;
worker_rlimit_nofile 100000;

load_module /usr/lib/nginx/modules/ngx_http_zstd_filter_module.so;

pcre_jit on;

pid  /var/run/nginx.pid;

events {
    worker_connections  10524;
    multi_accept on;
       }

http   {
    index         index.html index.php;
    include       mime.types;
    default_type  application/octet-stream;

    ## Core http settings, one topic per file
    include http.d/logging.conf;
    include http.d/compression.conf;
    include http.d/core.conf;
    include http.d/proxy.conf;
    include http.d/cache_zones.conf;
    include http.d/limits.conf;
    include http.d/real_ip.conf;
    include http.d/upstreams.conf;

    ## Maps: magento, bots
    include maps/*.conf;

    ## Server blocks
    include /etc/nginx/sites-enabled/*.conf;

}
