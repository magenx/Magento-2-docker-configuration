# Map bot challenge exclude paths
map $uri $this_cookie_settings_paths {
    default 0;
  "~^/(graphql|media|static|cookie-settings|health_check.php)" 1;
}

# Container-to-container traffic (varnish health probes, Magento calling its own URLs) is not rate
# limited. $remote_addr here is the address after realip (http.d/real_ip.conf): a browser request
# forwarded by varnish with X-Forwarded-For still counts against the shopper's own IP.
geo $limit_internal {
    default        0;
    127.0.0.0/8    1;
    10.0.0.0/8     1;
    172.16.0.0/12  1;
    192.168.0.0/16 1;
}

# Map limit all requests but exclude paths and internal traffic
# (an empty key is not rate limited).
# Admin is exempt: one admin page fires many XHRs (mui/index/render, grids),
# which 1r/s turns into 429s, and the admin is already gated by the
# ipset/allow.conf allowlist (conf_m2/admin.conf) or Cloudflare Access, and Magento's login lockout.
# /rabbitmq/ and /mariadb/ are exempt for the same reason (UI polling), they exist
# on the private admin vhost only (sites-available/private_admin.conf).
map $limit_internal$request_uri $limit_all_request {
    default $binary_remote_addr;
  "~^1" "";
  "~^0/(media|static)/" "";
  "~^0/(index\.php/)?(${ADMIN_PATH}|adminhtml)(/|\?|$)" "";
  "~^0/(rabbitmq|mariadb)/" "";
}
